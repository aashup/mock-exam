APP_NAME="Exam Practice API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exam_app
DB_USERNAME=root
DB_PASSWORD=

# ── Docker (docker compose / make start) ──────────────────────────────
# When running inside the compose stack, point the API at the `db` service
# instead of localhost and use the MySQL credentials from docker-compose.yml:
#   DB_HOST=db
#   DB_DATABASE=exam_app
#   DB_USERNAME=root
#   DB_PASSWORD=tiger

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum: allow the mobile app (no domain) — token-based auth needs no stateful domains.
SANCTUM_STATEFUL_DOMAINS=localhost

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@exam-app.test"
MAIL_FROM_NAME="${APP_NAME}"
